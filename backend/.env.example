APP_NAME=Laravel
APP_ENV=local
# ⚠️ 本機開發專用的固定金鑰，不是祕密。正式環境由平台注入 APP_KEY，entrypoint.sh
# 偵測到環境已有這個變數就完全不會建立 .env，因此這一行永遠不會生效。
#
# 為什麼要寫死而不是每次產生：entrypoint 是每個容器各跑一次的。加入 queue-worker
# 之後，web 與 worker 會各自產生一把不同的金鑰 —— 於是一邊 encrypt() 的東西另一邊
# 解不開，一邊簽出來的網址另一邊驗不過。而且容器重啟就換一把，session 全部失效。
APP_KEY=base64:RmNKosLEhp2V4nm5W6NDkBY9GZbWObe+HhSZZKKIumw=
APP_DEBUG=true
APP_URL=http://localhost

FRONTEND_URL=http://localhost:5173

LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
LINE_REDIRECT_URI=http://localhost:8080/api/auth/line/callback

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# 是否填入示範用的假資料（測試使用者、示範活動）。基礎資料不受影響，永遠都會填。
# 未設定時，非正式環境為 true、正式環境為 false。
# SEED_DEMO_DATA=true

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

REDIS_IDEMPOTENCY_DB=2
THROTTLE_REGISTRATION_LIMIT=5
THROTTLE_REGISTRATION_WINDOW=60

# 部署到雲端平台時，改設一個 REDIS_URL 就好（會覆寫上面的 host / port / password）。
# 真實的值請設在平台的環境變數，不要填在這裡 —— 這個檔案是本機開發用的預設值，
# 填了雲端的位址會讓本機的 docker compose 連不到自己的 redis 容器。
# 例如 Render Key Value 的 Internal URL：redis://red-xxxxxxxxxxxx:6379
# REDIS_URL=
# ⚠️ URL 若帶路徑（/0）會覆寫所有連線的 database，讓三個 db 的隔離失效 —— 不要加路徑。

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

